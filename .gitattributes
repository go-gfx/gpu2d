# Generated files keep the generator's LF line endings on every checkout,
# Windows included: TestKernelMetalIsGenerated compares the committed file
# byte for byte with what the generator writes.
metal/kernel_gen.metal text eol=lf
# kernel.wgsl is embedded and compared character for character with the shader
# it shares its coverage functions with; keep it LF too.
kernel.wgsl text eol=lf
webgpu/shader.wgsl text eol=lf
# kernel_gen.spv is compared byte for byte with what the generator writes.
vulkan/kernel_gen.spv binary
vulkan/kernel_rte_gen.spv binary
d3d11/kernel_gen.dxbc binary
d3d11/kernel_gen.dxbc.record text eol=lf
d3d11/kernel_gen.hlsl text eol=lf
